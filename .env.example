# Энэ файлыг .env нэрээр хуулж, утгуудыг өөрчилнө.
# .env файл git-д орохгүй (.gitignore).

PORT=3000
NODE_ENV=development

# Session-ийн нууц түлхүүр — урт, санамсаргүй утга оруулна
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite өгөгдлийн сангийн файл
DB_FILE=database/odb.db

# Seed хийх үед demo хэрэглэгчдэд өгөх нууц үг
DEMO_PASSWORD=Odb@2026demo

# Хичээлийн жил, хүсэлтийн эцсийн хугацааг энэ цагийн бүсээр тооцно (заавал биш)
TIME_ZONE=Asia/Ulaanbaatar
