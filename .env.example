PORT=3000
NODE_ENV=development

# Session cookie-г гарын үсгээр баталгаажуулах нууц түлхүүр (урт, санамсаргүй байх)
SESSION_SECRET=change-me-to-a-long-random-string

# Demo хэрэглэгчдийн нууц үг (npm run seed ашиглана)
DEMO_PASSWORD=ChangeMe2026!

# SQLite өгөгдлийн сангийн файл
DB_FILE=data/odb.db
